# Copy this file to .env.production and fill in the values BEFORE `npm run build`.
# Nothing here is a secret: these values are written into the public website.

# The full public address of the site, with no trailing slash, including any sub-path.
# Used for: canonical link, share-preview address (og:url), absolute share image, sitemap.xml,
# the Sitemap line in robots.txt, and url/image in the structured data.
# Leave EMPTY until the real domain exists: nothing is guessed, and localhost is never published.
# Example once a domain is bought:  VITE_SITE_URL=https://www.bishalraj.example
VITE_SITE_URL=

# Only if the site is served from a sub-folder (for example GitHub Pages project pages:
# https://username.github.io/portfolio/ ). Leave empty for a domain, Netlify, Vercel, Cloudflare Pages.
# Example:  VITE_BASE_PATH=/portfolio/
VITE_BASE_PATH=
